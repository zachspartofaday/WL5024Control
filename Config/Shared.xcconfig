// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = WL5024Control
PRODUCT_DISPLAY_NAME = WL5024 Control
PRODUCT_BUNDLE_IDENTIFIER = com.zachskjaveland.WL5024Control
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 26.0
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
ARCHS = arm64
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_HARDENED_RUNTIME = YES
DEVELOPMENT_TEAM = 9T97GZT4MV
CODE_SIGN_STYLE = Automatic

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = $(PRODUCT_DISPLAY_NAME)
INFOPLIST_KEY_LSUIElement = NO
INFOPLIST_KEY_NSBluetoothAlwaysUsageDescription = WL5024 Control uses Bluetooth to read and update settings on an already paired Dell WL5024 headset.

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/WL5024Control.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/WL5024Control.entitlements
